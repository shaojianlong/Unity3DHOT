{
  "$comment": "Unity3DHOT 候选源。2026-10-05 核对入口；全部停用，需在实际部署中预览和核对正文/日期后启用。首次启动只补新增 id，不覆盖已有数据库信源。",
  "sources": [
    {
      "id": "game-unity-blog",
      "name": "Unity Blog",
      "kind": "web_list",
      "config": {
        "url": "https://unity.com/cn/blog",
        "linkSelector": "a[href^=\"/cn/blog/\"]",
        "allowUrlPrefixes": ["https://unity.com/cn/blog/"],
        "parseMode": "html",
        "itemSelector": "div[class~=\"mango:group/card\"]",

        "titleSelector": "h3",

        "detail": {
          "maxFetches": 20,
          "titleSelector": "h1",
          "publishedAtRegex": "\"datePublished\"\\s*:\\s*\"([^\"]+)\""
        },
        "_aihot": {
          "initialBackfillLimit": 5,
          "initialBackfillMonths": 3
        }
      },
      "tier": "T1",
      "owner_entity_id": "unity",
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": false
    },
